{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hinan-saki",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hinan-saki.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": { "crons": ["1 21 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hinan-saki",
      "database_id": "a90917e6-cc85-4601-9ef2-f847ce77dc55",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
